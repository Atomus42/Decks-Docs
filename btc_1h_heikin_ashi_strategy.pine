// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// BTC/USD 1H Heikin Ashi Weekly Strategy — Winner of 48-strategy V2 backtest
// +78.40% return | Sharpe 1.53 | MaxDD -17.78% | 53% win rate | PF 1.94

//@version=6
strategy("BTC 1H Heikin Ashi Weekly (12G/6R)", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=99, initial_capital=100000, commission_type=strategy.commission.percent,
     commission_value=0.075, slippage=1, calc_on_every_tick=false)

// ============================================================================
// INPUTS
// ============================================================================

greenEntry = input.int(12,  "Consecutive Green HA Bars for Entry",  minval=1, maxval=50,  group="Heikin Ashi")
redExit    = input.int(6,   "Consecutive Red HA Bars for Exit",     minval=1, maxval=50,  group="Heikin Ashi")

showHA     = input.bool(true,  "Show HA Candle Colors on Bars",  group="Visuals")
showCounts = input.bool(true,  "Show Green/Red Streak Count",    group="Visuals")
showSignals = input.bool(true, "Show Entry/Exit Markers",        group="Visuals")

// ============================================================================
// HEIKIN ASHI CALCULATION
// ============================================================================

// Compute Heikin Ashi values from regular OHLC
haClose = (open + high + low + close) / 4.0

var float haOpen = na
if na(haOpen[1])
    haOpen := (open + close) / 2.0
else
    haOpen := (haOpen[1] + haClose[1]) / 2.0

haHigh = math.max(high, haOpen, haClose)
haLow  = math.min(low, haOpen, haClose)

isGreen = haClose > haOpen
isRed   = haClose <= haOpen

// ============================================================================
// CONSECUTIVE CANDLE COUNTING
// ============================================================================

var int consecGreen = 0
var int consecRed   = 0

if isGreen
    consecGreen := consecGreen + 1
    consecRed   := 0
else
    consecRed   := consecRed + 1
    consecGreen := 0

// ============================================================================
// STRATEGY LOGIC
// ============================================================================

inPosition = strategy.position_size > 0

// Entry: 12+ consecutive green HA candles
longEntry = consecGreen >= greenEntry and not inPosition

// Exit: 6+ consecutive red HA candles
longExit = consecRed >= redExit and inPosition

if longEntry
    strategy.entry("Long", strategy.long)

if longExit
    strategy.close("Long", comment="HA Red Exit")

// ============================================================================
// PLOTS
// ============================================================================

// Color bars based on HA candle color when in position
barcolor(showHA and inPosition and isGreen ? color.new(#26A69A, 30) :
         showHA and inPosition and isRed ? color.new(#EF5350, 30) :
         showHA and not inPosition and isGreen ? color.new(#26A69A, 75) :
         showHA and not inPosition and isRed ? color.new(#EF5350, 75) : na)

// Entry/exit markers
plotshape(showSignals and longEntry,
     title="Entry Signal", style=shape.triangleup, location=location.belowbar,
     color=color.new(#26A69A, 0), size=size.small, text="Long")

plotshape(showSignals and longExit,
     title="Exit Signal", style=shape.triangledown, location=location.abovebar,
     color=color.new(#EF5350, 0), size=size.small, text="Exit")

// Green/Red streak as a background intensity (optional visual)
streakColor = isGreen ? color.new(#26A69A, 100 - math.min(consecGreen * 5, 70)) :
                        color.new(#EF5350, 100 - math.min(consecRed * 5, 70))
bgcolor(showCounts ? streakColor : na, title="Streak Intensity")

// ============================================================================
// INFO TABLE
// ============================================================================

var table infoTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80),
     border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(infoTable, 0, 0, "Metric",           text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 0, "Value",             text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(infoTable, 0, 1, "Entry Threshold",   text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 1, str.tostring(greenEntry) + " green HA bars", text_color=#26A69A, text_size=size.small, text_halign=text.align_right)

    table.cell(infoTable, 0, 2, "Exit Threshold",    text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 2, str.tostring(redExit) + " red HA bars", text_color=#EF5350, text_size=size.small, text_halign=text.align_right)

    table.cell(infoTable, 0, 3, "Timeframe",         text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 3, "1H (recommended)",   text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(infoTable, 0, 4, "In Position",       text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 4, inPosition ? "YES" : "NO", text_color=inPosition ? #26A69A : color.red, text_size=size.small, text_halign=text.align_right)

    table.cell(infoTable, 0, 5, "Green Streak",      text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 5, str.tostring(consecGreen), text_color=#26A69A, text_size=size.small, text_halign=text.align_right)

    table.cell(infoTable, 0, 6, "Red Streak",        text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTable, 1, 6, str.tostring(consecRed), text_color=#EF5350, text_size=size.small, text_halign=text.align_right)
