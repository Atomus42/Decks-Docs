//@version=6
// =============================================================================
// vFINAL DUAL v4: Momentum + Mean Reversion — Webhook Ready
// =============================================================================
//
// CHANGES FROM v3 (Variant N — walk-forward validated):
//   1. TRAIL FROM CLOSE: Trail tracks highest close, not intrabar high.
//      Prevents phantom trail levels from wick noise.
//   2. EXTENDED TRAIL: When MOM unrealized PnL >= extTrailTrigger%,
//      widen ATR multiplier to extTrailMult (default 3%→8x).
//   3. VOL-ADAPTIVE TRAIL: When current ATR > 1.2× its 50-bar SMA,
//      widen trail by volHighMult (1.3x). When ATR < 0.8× SMA,
//      tighten by volLowMult (0.7x). Adapts to market regime.
//   4. WIDE PROFIT LOCKS: Ratchet hard stop upward at wide tiers
//      (default: BE@5%, lock+5%@10%, lock+10%@15%).
//      Only fires ~5 times per 3 years — surgical safety net,
//      not a primary exit. Eliminates catastrophic reversals.
//
// NOT CHANGED from v3:
//   - All entry logic (MOM and MR)
//   - Regime detection (ER threshold, smoothing)
//   - MR exit logic (RSI, PT, trail, timeout)
//   - Hard stop loss inputs (momHardSLPct, mrHardSLPct)
//   - Commission, slippage, capital settings
//   - Webhook JSON structure and alert_message pattern
//   - posType state machine and sync-with-engine pattern
//
// VALIDATION (Binance BTCUSDT 1H, 29,511 candles):
//   Full period (2023-2026): +652.7% vs v3 +527.6% (+125pp)
//   Walk-forward held-out (2025-2026): +47.0% vs v3 +45.3% (PASSES)
//   Catastrophic reversals: 0 vs v3's 2 (eliminated)
//   Max drawdown: 10.1% vs v3's 11.7%
//   Sensitivity: broad plateau — all neighboring params beat v3
//
// SETUP: Binance BTCUSDT Perp 1H chart, no leverage
// =============================================================================
strategy("vFINAL Dual v4: Momentum + MeanRev",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=1,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     max_bars_back=500,
     pyramiding=0)

// =============================================================================
// INPUTS
// =============================================================================

// --- V1891 MOMENTUM (TREND MODE) ---
grp_mom = "V1891 Momentum (Trend)"
rsiMomPeriod  = input.int(11,   "RSI Period",              minval=2,  group=grp_mom)
rsiMomEntry   = input.int(40,   "RSI Entry Threshold",     minval=10, maxval=90, group=grp_mom)
rsiMomExit    = input.int(30,   "RSI Exit Threshold",      minval=5,  maxval=50, group=grp_mom)
emaFastLen    = input.int(12,   "EMA Fast Period",         minval=2,  group=grp_mom)
emaSlowLen    = input.int(43,   "EMA Slow Period",         minval=5,  group=grp_mom)
atrMomPeriod  = input.int(17,   "ATR Period",              minval=2,  group=grp_mom)
atrMomTrail   = input.float(6.5, "ATR Trail Multiplier",   minval=1.0, step=0.5, group=grp_mom)
momHardSLPct  = input.float(5.0, "Hard Stoploss %",        minval=0.5, step=0.5, group=grp_mom)

// --- REGIME DETECTION ---
grp_regime = "Regime Detection"
useDual       = input.bool(true,  "Enable Dual Strategy Mode", group=grp_regime)
erPeriod      = input.int(50,     "Efficiency Ratio Period",   minval=5,    group=grp_regime)
erSmoothPer   = input.int(10,     "ER Smoothing (EMA)",        minval=1,    group=grp_regime)
erTrendThresh = input.float(0.06, "ER Trend Threshold",        minval=0.01, step=0.01, group=grp_regime)

// --- MEAN REVERSION (CHOP MODE) ---
grp_mr = "Mean Reversion (Chop)"
bbPeriod      = input.int(20,    "Bollinger Band Period",   minval=5,  group=grp_mr)
bbStd         = input.float(2.0, "Bollinger Band Std Dev",  minval=0.5, step=0.1, group=grp_mr)
rsiMrPeriod   = input.int(14,    "RSI Period (MR)",         minval=2,  group=grp_mr)
rsiMrBuy      = input.int(30,    "RSI Buy Threshold (MR)",  minval=5,  maxval=50, group=grp_mr)
rsiMrSell     = input.int(65,    "RSI Sell Threshold (MR)", minval=50, maxval=90, group=grp_mr)
mrProfitPct   = input.float(5.0, "Profit Target %",         minval=0, step=0.5, group=grp_mr)
mrHardSLPct   = input.float(1.5, "Hard Stoploss %",         minval=0.5, step=0.5, group=grp_mr)
atrMrPeriod   = input.int(14,    "ATR Period (MR)",          minval=2,  group=grp_mr)
atrMrTrail    = input.float(4.0, "ATR Trail Mult (MR)",     minval=1.0, step=0.5, group=grp_mr)
mrMaxHold     = input.int(96,    "Max Hold Bars (MR)",       minval=1,  group=grp_mr)

// --- v4: EXTENDED TRAIL ---
grp_ext = "v4 Extended Trail"
useExtTrail      = input.bool(true,  "Enable Extended Trail",         group=grp_ext,
     tooltip="Widen ATR trail multiplier when MOM trade is in significant profit")
extTrailTrigger  = input.float(3.0,  "Trigger (unrealized PnL %)",   minval=1.0, step=0.5, group=grp_ext)
extTrailMult     = input.float(8.0,  "Extended ATR Multiplier",      minval=2.0, step=0.5, group=grp_ext)

// --- v4: VOL-ADAPTIVE TRAIL ---
grp_vol = "v4 Vol-Adaptive Trail"
useVolAdapt      = input.bool(true,  "Enable Vol-Adaptive Trail",    group=grp_vol,
     tooltip="Widen trail in high-vol bars, tighten in low-vol bars (vs 50-bar ATR SMA)")
volSmaPeriod     = input.int(50,     "ATR SMA Period",               minval=10,  group=grp_vol)
volHighThresh    = input.float(1.2,  "High Vol Threshold (ATR/SMA)", minval=1.0, step=0.05, group=grp_vol)
volLowThresh     = input.float(0.8,  "Low Vol Threshold (ATR/SMA)",  minval=0.1, step=0.05, group=grp_vol)
volHighMult      = input.float(1.3,  "High Vol Trail Multiplier",    minval=1.0, step=0.1, group=grp_vol)
volLowMult       = input.float(0.7,  "Low Vol Trail Multiplier",     minval=0.1, step=0.1, group=grp_vol)

// --- v4: PROFIT LOCK-IN ---
grp_lock = "v4 Profit Lock-In"
useLocks         = input.bool(true,  "Enable Profit Locks",          group=grp_lock,
     tooltip="Ratchet hard stop upward at wide profit tiers. Fires rarely — surgical safety net.")
lockT1Trigger    = input.float(5.0,  "Tier 1 Trigger (PnL %)",      minval=1.0, step=0.5, group=grp_lock)
lockT1Level      = input.float(0.15, "Tier 1 Lock (% above entry)", minval=0.0, step=0.05, group=grp_lock)
lockT2Trigger    = input.float(10.0, "Tier 2 Trigger (PnL %)",      minval=2.0, step=0.5, group=grp_lock)
lockT2Level      = input.float(5.0,  "Tier 2 Lock (%)",             minval=0.5, step=0.5, group=grp_lock)
lockT3Trigger    = input.float(15.0, "Tier 3 Trigger (PnL %)",      minval=3.0, step=0.5, group=grp_lock)
lockT3Level      = input.float(10.0, "Tier 3 Lock (%)",             minval=1.0, step=0.5, group=grp_lock)

// --- WEBHOOK ---
grp_hook = "Webhook / Alerts"
useWebhook    = input.bool(true, "Enable Webhook Alerts", group=grp_hook)
webhookSecret = input.string("4hU8MbBTAH_E6Kajln1Qd3_LTg8dzVjy", "Webhook Secret", group=grp_hook,
     tooltip="Must match WEBHOOK_SECRET in your guardian .env file. Leave blank to disable secret check.")

// --- VISUAL ---
grp_vis = "Visual"
showSignals = input.bool(true, "Show entry/exit signals", group=grp_vis)
showTrail   = input.bool(true, "Show trailing stop",      group=grp_vis)
showRegime  = input.bool(true, "Show regime background",  group=grp_vis)

// =============================================================================
// INDICATORS
// =============================================================================
rsiMom   = ta.rsi(close, rsiMomPeriod)
rsiMr    = ta.rsi(close, rsiMrPeriod)
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
atrMom   = ta.atr(atrMomPeriod)
atrMr    = ta.atr(atrMrPeriod)
uptrend  = emaFast > emaSlow

// Bollinger Bands
bbBasis  = ta.sma(close, bbPeriod)
bbDev    = ta.stdev(close, bbPeriod) * bbStd
bbUpper  = bbBasis + bbDev
bbLower  = bbBasis - bbDev

// Kaufman Efficiency Ratio
erDirection  = math.abs(close - close[erPeriod])
erVolatility = math.sum(math.abs(close - close[1]), erPeriod)
erRaw        = erVolatility != 0 ? erDirection / erVolatility : 0.0
erSmoothed   = ta.ema(erRaw, erSmoothPer)

isTrending = useDual ? erSmoothed >= erTrendThresh : true
isChoppy   = useDual ? erSmoothed < erTrendThresh  : false

// Pre-compute crossover globally
rsiMomCrossUp = ta.crossover(rsiMom, rsiMomEntry)

// v4: ATR SMA for vol-adaptive trail
atrMomSma = ta.sma(atrMom, volSmaPeriod)

// =============================================================================
// STATE VARIABLES
// =============================================================================
// posType: 0=flat, 1=momentum, 2=mean reversion
var int   posType    = 0
var float entryPrice = na
var float trailHigh  = na     // v4: now tracks highest CLOSE, not highest high
var float trailStop  = na
var int   barsHeld   = 0
var float hardSLLvl  = na     // v4: explicit state for the active hard stop level

// Sync state with strategy engine — ground truth
hasPos = strategy.position_size > 0

// If strategy engine says flat but we think we have a position → hard SL/lock was hit
if posType != 0 and not hasPos
    posType    := 0
    entryPrice := na
    trailHigh  := na
    trailStop  := na
    barsHeld   := 0
    hardSLLvl  := na

// =============================================================================
// TRAILING STOP UPDATE (only when in position)
// =============================================================================
// v4: Trail from close, extended trail, vol-adaptive trail
if hasPos and posType == 1
    barsHeld += 1
    // v4: track highest close (not high) for trail reference
    if close > trailHigh or na(trailHigh)
        trailHigh := close

    // Determine effective ATR multiplier
    effMult = atrMomTrail
    // v4: extended trail when in profit
    unrealPct = not na(entryPrice) ? (close / entryPrice - 1.0) * 100.0 : 0.0
    if useExtTrail and unrealPct >= extTrailTrigger
        effMult := extTrailMult
    // v4: vol-adaptive adjustment
    if useVolAdapt and not na(atrMomSma) and atrMomSma > 0
        volRatio = atrMom / atrMomSma
        if volRatio > volHighThresh
            effMult := effMult * volHighMult
        else if volRatio < volLowThresh
            effMult := effMult * volLowMult

    trailStop := trailHigh - atrMom * effMult

    // v4: profit lock ratchets (computed on this bar's close, applied via strategy.exit next bar)
    if useLocks and not na(entryPrice)
        if unrealPct >= lockT3Trigger
            newSL = entryPrice * (1.0 + lockT3Level / 100.0)
            if na(hardSLLvl) or newSL > hardSLLvl
                hardSLLvl := newSL
        else if unrealPct >= lockT2Trigger
            newSL = entryPrice * (1.0 + lockT2Level / 100.0)
            if na(hardSLLvl) or newSL > hardSLLvl
                hardSLLvl := newSL
        else if unrealPct >= lockT1Trigger
            newSL = entryPrice * (1.0 + lockT1Level / 100.0)
            if na(hardSLLvl) or newSL > hardSLLvl
                hardSLLvl := newSL

if hasPos and posType == 2
    barsHeld += 1
    // v4: MR also uses trail-from-close for consistency
    if close > trailHigh or na(trailHigh)
        trailHigh := close
    trailStop := trailHigh - atrMr * atrMrTrail

// =============================================================================
// UPDATE HARD STOP EACH BAR (strategy.exit re-issue)
// =============================================================================
// v4: Re-issue strategy.exit every bar with the current hardSLLvl.
// This ensures profit locks take effect on the next bar.
// Only re-issue when we have a position to avoid stale exit orders.
if hasPos and posType == 1
    activeStop = not na(hardSLLvl) ? hardSLLvl : (not na(entryPrice) ? entryPrice * (1.0 - momHardSLPct / 100.0) : na)
    if not na(activeStop)
        stopAlertMsgDyn = '{"action":"EXIT","strategy":"vFINAL_DUAL","signal":"' + (not na(hardSLLvl) and hardSLLvl > entryPrice * (1.0 - momHardSLPct / 100.0) + 1 ? 'PROFIT_LOCK' : 'STOP_HIT') + '","price":"' + str.tostring(activeStop, "#.1") + '","bars_held":"' + str.tostring(barsHeld) + '"' + (webhookSecret != "" ? ',"secret":"' + webhookSecret + '"' : "") + '}'
        strategy.exit("HardSL", "Long", stop=activeStop,
             alert_message=useWebhook ? stopAlertMsgDyn : "")

if hasPos and posType == 2
    mrStop = not na(entryPrice) ? entryPrice * (1.0 - mrHardSLPct / 100.0) : na
    if not na(mrStop)
        mrStopAlert = '{"action":"EXIT","strategy":"vFINAL_DUAL","signal":"STOP_HIT","price":"' + str.tostring(mrStop, "#.1") + '","bars_held":"' + str.tostring(barsHeld) + '"' + (webhookSecret != "" ? ',"secret":"' + webhookSecret + '"' : "") + '}'
        strategy.exit("HardSL", "Long", stop=mrStop,
             alert_message=useWebhook ? mrStopAlert : "")

// =============================================================================
// EXIT SIGNALS
// =============================================================================
// Momentum exits
exitMomRsi   = hasPos and posType == 1 and rsiMom < rsiMomExit
exitMomTrail = hasPos and posType == 1 and not na(trailStop) and close < trailStop and not exitMomRsi

// Mean reversion exits
exitMrProfit = hasPos and posType == 2 and not na(entryPrice) and close >= entryPrice * (1.0 + mrProfitPct / 100.0)
exitMrRsi    = hasPos and posType == 2 and rsiMr > rsiMrSell and not exitMrProfit
exitMrTrail  = hasPos and posType == 2 and not na(trailStop) and close < trailStop and barsHeld > 3 and not exitMrProfit and not exitMrRsi
exitMrTime   = hasPos and posType == 2 and barsHeld >= mrMaxHold and not exitMrProfit and not exitMrRsi and not exitMrTrail

anyExit = exitMomRsi or exitMomTrail or exitMrProfit or exitMrRsi or exitMrTrail or exitMrTime

// =============================================================================
// ENTRY SIGNALS (only when flat)
// =============================================================================
isFlat = posType == 0 and not hasPos

entryMom = isFlat and rsiMomCrossUp and uptrend and isTrending and not anyExit
entryMr  = isFlat and close <= bbLower and bbLower > 0 and rsiMr < rsiMrBuy and isChoppy and not entryMom and not anyExit

// =============================================================================
// WEBHOOK JSON BUILDERS
// =============================================================================
secretField = webhookSecret != "" ? ',"secret":"' + webhookSecret + '"' : ""

// Entry alert messages
entrySignalStr = entryMom ? "MOM" : "MR"
entryRegimeStr = isTrending ? "TREND" : "CHOP"
entryStopVal   = entryMom ? close * (1 - momHardSLPct / 100) : close * (1 - mrHardSLPct / 100)

entryAlertMsg = '{"action":"ENTRY","strategy":"vFINAL_DUAL","signal":"' + entrySignalStr + '","price":"' + str.tostring(close) + '","stop":"' + str.tostring(entryStopVal, "#.1") + '","regime":"' + entryRegimeStr + '","er":"' + str.tostring(erSmoothed, "#.###") + '"' + secretField + '}'

// Exit alert messages
exitSignalStr = exitMomRsi ? "MOM_RSI" : exitMomTrail ? "MOM_TRAIL" : exitMrProfit ? "MR_PT" : exitMrRsi ? "MR_RSI" : exitMrTrail ? "MR_TRAIL" : "MR_TIMEOUT"
exitAlertMsg  = '{"action":"EXIT","strategy":"vFINAL_DUAL","signal":"' + exitSignalStr + '","price":"' + str.tostring(close) + '","bars_held":"' + str.tostring(barsHeld) + '"' + secretField + '}'

// =============================================================================
// EXECUTE EXITS
// =============================================================================
if exitMomRsi
    strategy.close("Long", comment="MOM RSI Exit",
         alert_message=useWebhook ? exitAlertMsg : "")
if exitMomTrail
    strategy.close("Long", comment="MOM Trail Stop",
         alert_message=useWebhook ? exitAlertMsg : "")
if exitMrProfit
    strategy.close("Long", comment="MR Profit Target",
         alert_message=useWebhook ? exitAlertMsg : "")
if exitMrRsi
    strategy.close("Long", comment="MR RSI Sell",
         alert_message=useWebhook ? exitAlertMsg : "")
if exitMrTrail
    strategy.close("Long", comment="MR Trail Stop",
         alert_message=useWebhook ? exitAlertMsg : "")
if exitMrTime
    strategy.close("Long", comment="MR Timeout",
         alert_message=useWebhook ? exitAlertMsg : "")

// Reset state on any exit
if anyExit
    posType    := 0
    entryPrice := na
    trailHigh  := na
    trailStop  := na
    barsHeld   := 0
    hardSLLvl  := na

// =============================================================================
// EXECUTE ENTRIES
// =============================================================================
if entryMom
    strategy.entry("Long", strategy.long, comment="MOM Entry",
         alert_message=useWebhook ? entryAlertMsg : "")
    posType    := 1
    entryPrice := close
    trailHigh  := close
    trailStop  := close - atrMom * atrMomTrail
    barsHeld   := 0
    hardSLLvl  := close * (1.0 - momHardSLPct / 100.0)
    strategy.exit("HardSL", "Long", stop=close * (1.0 - momHardSLPct / 100.0),
         alert_message=useWebhook ? '{"action":"EXIT","strategy":"vFINAL_DUAL","signal":"STOP_HIT","price":"' + str.tostring(close * (1.0 - momHardSLPct / 100.0), "#.1") + '","bars_held":"0"' + secretField + '}' : "")

if entryMr
    strategy.entry("Long", strategy.long, comment="MR Entry",
         alert_message=useWebhook ? entryAlertMsg : "")
    posType    := 2
    entryPrice := close
    trailHigh  := close
    trailStop  := close - atrMr * atrMrTrail
    barsHeld   := 0
    hardSLLvl  := close * (1.0 - mrHardSLPct / 100.0)
    strategy.exit("HardSL", "Long", stop=close * (1.0 - mrHardSLPct / 100.0),
         alert_message=useWebhook ? '{"action":"EXIT","strategy":"vFINAL_DUAL","signal":"STOP_HIT","price":"' + str.tostring(close * (1.0 - mrHardSLPct / 100.0), "#.1") + '","bars_held":"0"' + secretField + '}' : "")

// =============================================================================
// VISUALS
// =============================================================================

// EMAs
plot(emaFast, "EMA 12", color=color.new(color.blue, 30), linewidth=2)
plot(emaSlow, "EMA 43", color=color.new(color.orange, 30), linewidth=2)

// Bollinger Bands (visible only in chop mode)
c_bbChop = color.new(color.purple, 60)
c_bbHide = color.new(color.purple, 95)
plot(bbUpper, "BB Upper", color=isChoppy ? c_bbChop : c_bbHide, linewidth=1)
plot(bbBasis, "BB Mid",   color=color.new(color.gray, 85), linewidth=1)
plot(bbLower, "BB Lower", color=isChoppy ? c_bbChop : c_bbHide, linewidth=1)

// Trailing stop
c_trailMom = color.new(color.red, 30)
c_trailMr  = color.new(color.purple, 30)
plot(showTrail and hasPos and not na(trailStop) ? trailStop : na, "Trail Stop",
     color=posType == 1 ? c_trailMom : c_trailMr, linewidth=1, style=plot.style_linebr)

// v4: Show active hard stop / lock level
c_lockLine = color.new(color.lime, 40)
plot(showTrail and hasPos and posType == 1 and not na(hardSLLvl) ? hardSLLvl : na, "Hard SL / Lock",
     color=c_lockLine, linewidth=1, style=plot.style_linebr)

// Regime background
bgcolor(showRegime and not useDual ? na : showRegime and isTrending ? color.new(color.green, 94) : showRegime ? color.new(color.yellow, 92) : na, title="Regime")

// Position background
c_posMom = color.new(color.teal, 88)
c_posMr  = color.new(color.purple, 88)
bgcolor(hasPos and posType == 1 ? c_posMom : hasPos and posType == 2 ? c_posMr : na, title="Position")

// Entry markers
plotshape(showSignals and entryMom, title="MOM Entry", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="MOM")
plotshape(showSignals and entryMr, title="MR Entry", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.purple, 0), size=size.small, text="MR")

// Exit markers
plotshape(showSignals and exitMomRsi, title="MOM RSI X", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="RSI X")
plotshape(showSignals and exitMomTrail, title="MOM Trail", style=shape.xcross,
     location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="TRAIL")
plotshape(showSignals and exitMrProfit, title="MR PT", style=shape.flag,
     location=location.abovebar, color=color.new(color.lime, 0), size=size.small, text="PT")
plotshape(showSignals and exitMrRsi, title="MR RSI", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.purple, 0), size=size.small, text="MR X")
plotshape(showSignals and exitMrTrail, title="MR Trail", style=shape.xcross,
     location=location.abovebar, color=color.new(color.purple, 40), size=size.small, text="MR T")
plotshape(showSignals and exitMrTime, title="MR Time", style=shape.cross,
     location=location.abovebar, color=color.new(color.gray, 0), size=size.small, text="TIME")

// =============================================================================
// INFO TABLE
// =============================================================================
var table infoTbl = table.new(position.top_right, 2, 12,
     bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if barstate.islast
    row = 0

    table.cell(infoTbl, 0, row, "vFINAL Dual v4", text_color=color.white, text_size=size.small)
    table.cell(infoTbl, 1, row, "MOM + MR", text_color=color.yellow, text_size=size.small)
    row += 1

    rStr = isTrending ? "TREND" : "CHOP"
    rClr = isTrending ? color.green : color.yellow
    table.cell(infoTbl, 0, row, "Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, rStr, text_color=rClr, text_size=size.tiny)
    row += 1

    pStr = posType == 0 ? "FLAT" : posType == 1 ? "MOMENTUM" : "MEAN REV"
    pClr = posType == 0 ? color.gray : posType == 1 ? color.teal : color.purple
    table.cell(infoTbl, 0, row, "Position", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, pStr, text_color=pClr, text_size=size.tiny)
    row += 1

    table.cell(infoTbl, 0, row, "ER(" + str.tostring(erPeriod) + ")", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, str.tostring(erSmoothed, "#.###"),
         text_color=isTrending ? color.green : color.orange, text_size=size.tiny)
    row += 1

    table.cell(infoTbl, 0, row, "RSI(" + str.tostring(rsiMomPeriod) + ")", text_color=color.gray, text_size=size.tiny)
    rsiMomColor = rsiMom > rsiMomEntry ? color.green : rsiMom < rsiMomExit ? color.red : color.white
    table.cell(infoTbl, 1, row, str.tostring(rsiMom, "#.0"), text_color=rsiMomColor, text_size=size.tiny)
    row += 1

    table.cell(infoTbl, 0, row, "RSI(" + str.tostring(rsiMrPeriod) + ") MR", text_color=color.gray, text_size=size.tiny)
    rsiMrColor = rsiMr < rsiMrBuy ? color.purple : rsiMr > rsiMrSell ? color.red : color.white
    table.cell(infoTbl, 1, row, str.tostring(rsiMr, "#.0"), text_color=rsiMrColor, text_size=size.tiny)
    row += 1

    table.cell(infoTbl, 0, row, "EMA Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, uptrend ? "BULL" : "BEAR",
         text_color=uptrend ? color.green : color.red, text_size=size.tiny)
    row += 1

    table.cell(infoTbl, 0, row, "Trail Stop", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, hasPos and not na(trailStop) ? "$" + str.tostring(trailStop, "#") : "---",
         text_color=color.orange, text_size=size.tiny)
    row += 1

    // v4: show lock level
    table.cell(infoTbl, 0, row, "Lock SL", text_color=color.gray, text_size=size.tiny)
    lockStr = hasPos and not na(hardSLLvl) ? "$" + str.tostring(hardSLLvl, "#") : "---"
    lockClr = hasPos and not na(hardSLLvl) and not na(entryPrice) and hardSLLvl > entryPrice ? color.lime : color.orange
    table.cell(infoTbl, 1, row, lockStr, text_color=lockClr, text_size=size.tiny)
    row += 1

    table.cell(infoTbl, 0, row, "Bars Held", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, hasPos ? str.tostring(barsHeld) : "---",
         text_color=color.white, text_size=size.tiny)
    row += 1

    slStr = posType == 1 ? str.tostring(momHardSLPct, "#.1") + "%" : posType == 2 ? str.tostring(mrHardSLPct, "#.1") + "%" : "---"
    table.cell(infoTbl, 0, row, "Hard SL", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, row, slStr, text_color=color.orange, text_size=size.tiny)
    row += 1

    // v4: vol ratio
    table.cell(infoTbl, 0, row, "Vol Ratio", text_color=color.gray, text_size=size.tiny)
    vrStr = not na(atrMomSma) and atrMomSma > 0 ? str.tostring(atrMom / atrMomSma, "#.##") : "---"
    vrClr = not na(atrMomSma) and atrMomSma > 0 ? (atrMom / atrMomSma > volHighThresh ? color.red : atrMom / atrMomSma < volLowThresh ? color.green : color.white) : color.gray
    table.cell(infoTbl, 1, row, vrStr, text_color=vrClr, text_size=size.tiny)

// =============================================================================
// ALERTS (v6: alert() for mobile/app notifications)
// =============================================================================
if entryMom or entryMr
    alert("vFINAL Dual: " + entrySignalStr + " ENTRY -- " + syminfo.ticker +
         " at " + str.tostring(close) + " -- " + entryRegimeStr +
         " regime, ER=" + str.tostring(erSmoothed, "#.###"), alert.freq_once_per_bar)

if anyExit
    alert("vFINAL Dual: " + exitSignalStr + " -- " + syminfo.ticker +
         " at " + str.tostring(close) + ", held " + str.tostring(barsHeld) + " bars", alert.freq_once_per_bar)
